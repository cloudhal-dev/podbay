{
	"include": [
		"test/**/*",
		"app/i18n/**/*.ts",
		"app/lib/mail-html.ts",
		"app/lib/inline-images.ts",
		"app/lib/search-parser.ts",
		"app/lib/sending-words.ts",
		"app/lib/address-suggestions.ts",
		"app/lib/label-tree.ts",
		"app/lib/original-text.ts",
		"app/lib/unsubscribe.ts",
		"app/lib/user-agent.ts",
		"app/lib/session.ts",
		"app/lib/live.ts",
		"app/lib/utils.ts",
		"app/hooks/useDisplay.ts",
		"app/hooks/useDraftFiles.ts",
		"app/hooks/useUIStore.ts",
		"app/hooks/useAnswerFollowsToWindow.ts",
		"app/components/EmailIframe.tsx",
		"app/services/api.ts",
		"app/types/**/*.ts",
		"workers/**/*",
		"shared/**/*",
		"packages/**/*",
		"modules/**/*",
		"scripts/**/*",
		"worker-configuration.d.ts"
	],
	"exclude": [
		"test/workerd/vitest.config.ts",
		"test/workerd-agent/vitest.config.ts",
		"test/e2e/playwright.config.ts"
	],
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client", "@cloudflare/vitest-plugin/types"],
		"target": "ES2023",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"paths": {
			"shared/*": ["./shared/*"],
			"~/*": ["./app/*"]
		}
	}
}
