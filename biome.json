{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.wrangler",
			"!**/node_modules",
			"!**/worker-configuration.d.ts",
			"!pnpm-lock.yaml",
			"!public",
			"!**/*.md",
			"!.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error",
				"noConsole": "error"
			},
			"style": {
				"noNonNullAssertion": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"workers/index.ts",
				"workers/durableObject/index.ts",
				"workers/email-sender.ts",
				"app/queries/*.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "warn"
					},
					"style": {
						"noNonNullAssertion": "warn"
					}
				}
			}
		},
		{
			"includes": [
				"app/components/ComposePanel.tsx",
				"app/components/EmailPanel.tsx",
				"app/components/MCPPanel.tsx",
				"app/components/email-panel/EmailPanelDialogs.tsx",
				"app/lib/search-parser.ts",
				"app/routes/email-list.tsx",
				"app/routes/home.tsx",
				"app/routes/mailbox.tsx",
				"app/routes/search-results.tsx"
			],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "warn",
						"useSemanticElements": "warn"
					},
					"correctness": {
						"useExhaustiveDependencies": "warn"
					},
					"suspicious": {
						"noArrayIndexKey": "warn",
						"noAssignInExpressions": "warn"
					}
				}
			}
		}
	]
}
