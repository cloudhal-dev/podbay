{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "podbay",
	"main": "./workers/app.ts",
	// V4: moved forward every month with the full test run.
	// Node.js compatibility is on by default from 2026-08-04 (docs/cloudflare/ledger.json).
	"compatibility_date": "2026-11-16",
	"observability": {
		"enabled": true
	},
	// The UI is a single-page app served as static assets. Only these paths reach the Worker.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/mcp", "/agents/*"]
	},
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker fails closed outside local development if Access is not configured.
		"DOMAINS": "example.com",
		"EMAIL_ADDRESSES": [],
		// Optional features, off by default. Set to "true" to turn one on.
		"AGENT_ENABLED": "false",
		"MCP_ENABLED": "false"
	},
	// Local development uses the simulated binding and never sends real mail (rule D7).
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// The index: accounts, sessions, mailboxes, memberships and the audit log. Mail content is not
	// here. The deployer supplies the real database id; local development and tests ignore it.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "podbay",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "podbay",
			"preview_bucket_name": "podbay"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MailboxDO"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["EmailAgent"]
		}
	]
}
