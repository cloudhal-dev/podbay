{
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"test/workerd/vitest.config.ts",
		"scripts/**/*",
		"shared/**/*",
		"test/workerd-agent/vitest.config.ts",
		"test/e2e/playwright.config.ts"
	],
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"lib": ["ES2023"],
		"types": ["node"],
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler"
	},
	"exclude": ["scripts/auth-ddl.ts"]
}
