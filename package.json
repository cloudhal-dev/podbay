{
	"name": "podbay",
	"version": "0.0.0",
	"private": true,
	"description": "Self-hosted mail that runs entirely in your own Cloudflare account",
	"homepage": "https://podbay.cloudhal.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudhal-dev/podbay.git"
	},
	"bugs": "https://github.com/cloudhal-dev/podbay/issues",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/dev-setup.ts && vite dev",
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"lint": "biome check .",
		"format": "biome check . --write",
		"static": "node scripts/check-static.ts && node scripts/auth-ddl.ts --check",
		"typecheck": "wrangler types && tsc -b",
		"test": "vitest run",
		"e2e": "playwright test --config test/e2e/playwright.config.ts",
		"test:workerd": "node scripts/test-workerd.ts",
		"check": "pnpm lint && pnpm static && pnpm typecheck && pnpm test && pnpm build",
		"pins": "node scripts/pins.ts --check",
		"pins:outdated": "node scripts/pins.ts --outdated",
		"auth:ddl": "node scripts/auth-ddl.ts --check"
	},
	"dependencies": {
		"@ai-sdk/provider": "4.0.38",
		"@ai-sdk/react": "4.0.177",
		"@better-auth/passkey": "1.7.23",
		"@cloudflare/ai-chat": "0.12.2",
		"@cloudflare/kumo": "2.18.1",
		"@modelcontextprotocol/sdk": "1.32.2",
		"@modelcontextprotocol/server": "2.4.0",
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-query": "5.107.1",
		"@tanstack/react-router": "1.170.46",
		"@tiptap/extension-color": "3.34.0",
		"@tiptap/extension-highlight": "3.34.0",
		"@tiptap/extension-image": "3.34.0",
		"@tiptap/extension-link": "3.34.0",
		"@tiptap/extension-text-align": "3.34.0",
		"@tiptap/extension-text-style": "3.34.0",
		"@tiptap/extension-underline": "3.34.0",
		"@tiptap/pm": "3.34.0",
		"@tiptap/react": "3.34.0",
		"@tiptap/starter-kit": "3.34.0",
		"agents": "0.33.0",
		"ai": "7.0.173",
		"better-auth": "1.7.23",
		"dompurify": "3.4.18",
		"drizzle-orm": "0.45.4",
		"hono": "4.13.18",
		"jose": "6.2.17",
		"postal-mime": "4.2.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"uqr": "0.1.3",
		"zod": "4.6.7",
		"zustand": "5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@cloudflare/vite-plugin": "1.69.1",
		"@cloudflare/vitest-plugin": "1.8.2",
		"@playwright/test": "1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/jsdom": "30.0.0",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"jsdom": "31.0.1",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	},
	"pinExceptions": {
		"@cloudflare/ai-chat": "2026-11-17: 0.x, no stable release exists; the agent is optional and off by default",
		"agents": "2026-11-17: 0.x, no stable release exists; the agent is optional and off by default",
		"drizzle-orm": "2026-11-17: 0.x, no stable release exists",
		"uqr": "2026-11-17: 0.x, no stable release exists; no dependencies; draws the authenticator QR code in the browser",
		"@types/node": "2026-11-17: follows the lowest supported Node (24), not the newest"
	}
}
