{
	"name": "podbay",
	"version": "0.0.0",
	"private": true,
	"description": "Self-hosted mail that runs entirely in your own Cloudflare account",
	"homepage": "https://podbay.cloudhal.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudhal-dev/podbay.git"
	},
	"bugs": "https://github.com/cloudhal-dev/podbay/issues",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/dev-setup.ts && vite dev",
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"lint": "biome check . --error-on-warnings",
		"format": "biome check . --write",
		"static": "node scripts/check-static.ts && node scripts/auth-ddl.ts --check",
		"typecheck": "wrangler types && tsc -b",
		"test": "vitest run",
		"e2e": "playwright test --config test/e2e/playwright.config.ts",
		"test:workerd": "node scripts/test-workerd.ts",
		"check": "pnpm lint && pnpm static && pnpm typecheck && pnpm test && pnpm build",
		"pins": "node scripts/pins.ts --check",
		"pins:outdated": "node scripts/pins.ts --outdated",
		"auth:ddl": "node scripts/auth-ddl.ts --check"
	},
	"dependencies": {
		"@ai-sdk/provider": "catalog:",
		"@ai-sdk/react": "catalog:",
		"@better-auth/passkey": "catalog:",
		"@cloudflare/ai-chat": "catalog:",
		"@cloudflare/kumo": "catalog:",
		"@modelcontextprotocol/sdk": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@phosphor-icons/react": "catalog:",
		"@podbay/contract": "workspace:*",
		"@podbay/i18n": "workspace:*",
		"@podbay/mail": "workspace:*",
		"@podbay/platform": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@tiptap/extension-color": "catalog:",
		"@tiptap/extension-highlight": "catalog:",
		"@tiptap/extension-image": "catalog:",
		"@tiptap/extension-link": "catalog:",
		"@tiptap/extension-text-align": "catalog:",
		"@tiptap/extension-text-style": "catalog:",
		"@tiptap/extension-underline": "catalog:",
		"@tiptap/pm": "catalog:",
		"@tiptap/react": "catalog:",
		"@tiptap/starter-kit": "catalog:",
		"agents": "catalog:",
		"ai": "catalog:",
		"better-auth": "catalog:",
		"dompurify": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"jose": "catalog:",
		"postal-mime": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "catalog:",
		"remark-gfm": "catalog:",
		"uqr": "catalog:",
		"zod": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@cloudflare/vite-plugin": "catalog:",
		"@cloudflare/vitest-plugin": "catalog:",
		"@playwright/test": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/jsdom": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"jsdom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"pinExceptions": {
		"@cloudflare/ai-chat": "2026-11-17: 0.x, no stable release exists; the agent is optional and off by default",
		"agents": "2026-11-17: 0.x, no stable release exists; the agent is optional and off by default",
		"drizzle-orm": "2026-11-17: 0.x, no stable release exists",
		"uqr": "2026-11-17: 0.x, no stable release exists; no dependencies; draws the authenticator QR code in the browser",
		"@types/node": "2026-11-17: follows the lowest supported Node (24), not the newest"
	}
}
